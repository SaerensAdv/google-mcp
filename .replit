modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
GOOGLE_ADS_MCP_BASE_URL = "https://sa-google-ads-mcp.replit.app"
PORT = "8080"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "google-ads-mcp"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "if [ -n \"$REPLIT_DOMAINS\" ]; then export GOOGLE_ADS_MCP_BASE_URL=\"https://${REPLIT_DOMAINS%%,*}\"; fi; exec google-ads-mcp"]
